# Supabase (conversations, users, open loops, agent initiation log)
# Newer Supabase projects label these "Publishable key" / "Secret key"
# instead of "anon key" / "service_role key" — the code accepts either
# naming (see lib/supabase/client.ts), but set ONE of each pair:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# — or, on newer projects —
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Neo4j (life map graph — required by lib/api/neo4j.ts)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Breeth (long-term memory — required by lib/agent/memory.ts)
BREETH_API_KEY=ck_live_your_breeth_key_here
BREETH_BASE_URL=https://api.thebreeth.com

# AI/LLM
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Emotion (GoEmotions via Hugging Face Inference API — optional; falls back
# to a keyword heuristic in lib/agent/emotion.ts if unset. No paid API needed.)
HUGGINGFACE_API_KEY=your_hf_token_here

# Speech-to-text (production path — optional today)
# Speech-to-text — AssemblyAI (required for voice input)
# The conversation page records audio with MediaRecorder and sends it to
# app/api/voice/transcribe, which tries providers in order: AssemblyAI →
# Speechmatics → Deepgram. Set as many as you have keys for — each is
# skipped (not treated as an error) if its key is unset, and the route
# only fails if every configured provider fails. AssemblyAI is primary;
# the browser's built-in SpeechRecognition API was tried first and
# dropped — unsupported in Firefox, and unreliable on many Android
# browsers (its `onend` event doesn't always fire, which caused the mic
# to get stuck showing "Listening..." indefinitely).
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
SPEECHMATICS_API_KEY=your_speechmatics_key_here
DEEPGRAM_API_KEY=your_deepgram_key_here

# Autonomy cycle cron protection (lib/agent — app/api/agent/cycle)
CRON_SECRET=set_a_random_secret_and_send_as_bearer_token

# Environment
NODE_ENV=development
